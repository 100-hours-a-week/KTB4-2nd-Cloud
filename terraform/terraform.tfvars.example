# Default values for the Yeodam V1 infrastructure.
# Copy this file to terraform.tfvars only when overriding these values locally.

aws_region         = "ap-northeast-2"
project_name       = "yeodam"
deployment_version = "v1"

vpc_cidr          = "10.20.0.0/16"
public_subnet_cidr = "10.20.1.0/24"
availability_zone = "ap-northeast-2a"
