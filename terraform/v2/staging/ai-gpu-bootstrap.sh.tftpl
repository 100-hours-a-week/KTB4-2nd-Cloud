#!/usr/bin/env bash
set -Eeuo pipefail

# Use the reviewed DLAMI's existing driver, Docker and NVIDIA toolkit.
# Installing another driver here could require a reboot or break CUDA support.
command -v nvidia-smi >/dev/null
command -v nvidia-ctk >/dev/null
command -v docker >/dev/null
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader
nvidia-ctk runtime configure --runtime=docker
systemctl enable docker
systemctl restart docker
docker compose version

expected_serial=$(printf '%s' '${volume_id}' | tr -d '-' | tr '[:upper:]' '[:lower:]')
device=''
for attempt in $(seq 1 120); do
  while read -r name serial kind; do
    [ "$kind" = disk ] || continue
    normalized=$(printf '%s' "$serial" | tr -d '-' | tr '[:upper:]' '[:lower:]')
    if [ "$normalized" = "$expected_serial" ]; then
      device="/dev/$name"
    fi
  done < <(lsblk -dn -o NAME,SERIAL,TYPE)
  [ -n "$device" ] && break
  sleep 5
done
[ -n "$device" ] || { echo 'Qdrant EBS was not attached' >&2; exit 1; }

filesystem=$(blkid -o value -s TYPE "$device" || true)
case "$filesystem" in
  '')
    if [ -n "$(wipefs --no-act --noheadings --output TYPE "$device")" ]; then
      echo 'Existing Qdrant disk signature requires manual recovery' >&2
      exit 1
    fi
    mkfs.ext4 "$device"
    ;;
  ext4) ;;
  *) echo "Unexpected Qdrant filesystem: $filesystem" >&2; exit 1 ;;
esac
uuid=$(blkid -o value -s UUID "$device")
install -d -m 0755 /data/qdrant
if ! grep -Fq "UUID=$uuid " /etc/fstab; then
  printf 'UUID=%s /data/qdrant ext4 defaults 0 2\n' "$uuid" >> /etc/fstab
fi
mountpoint -q /data/qdrant || mount /data/qdrant
[ "$(findmnt -no UUID /data/qdrant)" = "$uuid" ]
install -d -m 0750 /opt/yeodam-ai
install -d -m 0700 /etc/yeodam/ai
# Host cache survives container replacement and EC2 stop/start, not termination.
install -d -m 0755 /var/cache/yeodam/huggingface
printf 'GPU and Qdrant EBS host ready; application containers are not deployed.\n' \
  > /var/lib/yeodam-ai-gpu-host-ready
