{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowScopedEC2InstanceAccessActions",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ec2:ap-northeast-2::image/*",
        "arn:aws:ec2:ap-northeast-2::snapshot/*",
        "arn:aws:ec2:ap-northeast-2:483175530259:security-group/*",
        "arn:aws:ec2:ap-northeast-2:483175530259:subnet/*",
        "arn:aws:ec2:ap-northeast-2:483175530259:capacity-reservation/*",
        "arn:aws:ec2:ap-northeast-2:483175530259:placement-group/*"
      ],
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateFleet"
      ]
    },
    {
      "Sid": "AllowScopedEC2LaunchTemplateAccessActions",
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:ap-northeast-2:483175530259:launch-template/*",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateFleet"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/kubernetes.io/cluster/yeodam-v3-foundation": "owned",
          "aws:ResourceTag/karpenter.sh/nodepool": [
            "api",
            "worker"
          ]
        }
      }
    },
    {
      "Sid": "AllowScopedEC2InstanceActionsWithTags",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:483175530259:fleet/*",
        "arn:aws:ec2:ap-northeast-2:483175530259:instance/*",
        "arn:aws:ec2:ap-northeast-2:483175530259:volume/*",
        "arn:aws:ec2:ap-northeast-2:483175530259:network-interface/*",
        "arn:aws:ec2:ap-northeast-2:483175530259:launch-template/*",
        "arn:aws:ec2:ap-northeast-2:483175530259:spot-instances-request/*"
      ],
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateFleet",
        "ec2:CreateLaunchTemplate"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/kubernetes.io/cluster/yeodam-v3-foundation": "owned",
          "aws:RequestTag/eks:eks-cluster-name": "yeodam-v3-foundation",
          "aws:RequestTag/karpenter.sh/nodepool": [
            "api",
            "worker"
          ]
        }
      }
    },
    {
      "Sid": "AllowScopedResourceCreationTagging",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:483175530259:fleet/*",
        "arn:aws:ec2:ap-northeast-2:483175530259:instance/*",
        "arn:aws:ec2:ap-northeast-2:483175530259:volume/*",
        "arn:aws:ec2:ap-northeast-2:483175530259:network-interface/*",
        "arn:aws:ec2:ap-northeast-2:483175530259:launch-template/*",
        "arn:aws:ec2:ap-northeast-2:483175530259:spot-instances-request/*"
      ],
      "Action": "ec2:CreateTags",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/kubernetes.io/cluster/yeodam-v3-foundation": "owned",
          "aws:RequestTag/eks:eks-cluster-name": "yeodam-v3-foundation",
          "ec2:CreateAction": [
            "RunInstances",
            "CreateFleet",
            "CreateLaunchTemplate"
          ],
          "aws:RequestTag/karpenter.sh/nodepool": [
            "api",
            "worker"
          ]
        }
      }
    },
    {
      "Sid": "AllowScopedResourceTagging",
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:ap-northeast-2:483175530259:instance/*",
      "Action": "ec2:CreateTags",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/kubernetes.io/cluster/yeodam-v3-foundation": "owned",
          "aws:ResourceTag/karpenter.sh/nodepool": [
            "api",
            "worker"
          ]
        },
        "StringEqualsIfExists": {
          "aws:RequestTag/eks:eks-cluster-name": "yeodam-v3-foundation"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "eks:eks-cluster-name",
            "karpenter.sh/nodeclaim",
            "Name"
          ]
        }
      }
    },
    {
      "Sid": "AllowScopedDeletion",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:483175530259:instance/*",
        "arn:aws:ec2:ap-northeast-2:483175530259:launch-template/*"
      ],
      "Action": [
        "ec2:TerminateInstances",
        "ec2:DeleteLaunchTemplate"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/kubernetes.io/cluster/yeodam-v3-foundation": "owned",
          "aws:ResourceTag/karpenter.sh/nodepool": [
            "api",
            "worker"
          ]
        }
      }
    }
  ]
}
