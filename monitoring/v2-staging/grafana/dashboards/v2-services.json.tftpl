          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/ApplicationELB",
          "metricName": "TargetResponseTime",
          "statistic": "p95",
          "dimensions": {
            "LoadBalancer": [
              "${public_alb}"
            ]
          },
          "matchExact": true,
          "period": "60",
          "id": "",
          "expression": "",
          "label": "target response p95"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
