{
  "uid": "yeodam-v2-services",
  "title": "V2 staging services",
  "tags": [
    "yeodam",
    "staging",
    "v2"
  ],
  "schemaVersion": 41,
  "timezone": "browser",
  "refresh": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Public requests / minute",
      "description": "CloudWatch 60s period. Missing data is not zero. Response time is ALB target-header latency, not user job completion.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "staging-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "statistic": "Sum",
          "dimensions": {
            "LoadBalancer": [
              "${public_alb}"
            ]
          },
          "matchExact": true,
          "period": "60",
          "id": "",
          "expression": "",
          "label": "requests / minute"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Public target response p95",
      "description": "CloudWatch 60s period. Missing data is not zero. Response time is ALB target-header latency, not user job completion.",
