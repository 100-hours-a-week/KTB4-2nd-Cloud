    {
      "id": 12,
      "type": "timeseries",
      "title": "ECS service CPUUtilization",
      "description": "Service average, not per-task utilization. Task-local application saturation is covered separately.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "staging-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/ECS",
          "metricName": "CPUUtilization",
          "statistic": "Average",
          "dimensions": {
            "ClusterName": [
