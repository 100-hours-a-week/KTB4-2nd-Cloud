    {
      "id": 9,
      "type": "timeseries",
      "title": "FE ALB target health",
      "description": "Healthy Minimum / Unhealthy Maximum across the minute; not exact ECS running/desired task counts.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "staging-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "${region}",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HealthyHostCount",
          "statistic": "Minimum",
          "dimensions": {
            "LoadBalancer": [
