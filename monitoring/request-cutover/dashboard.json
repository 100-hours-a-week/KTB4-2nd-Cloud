{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "yeodam-request-auth-cutover",
  "title": "Yeodam Request/Auth Cutover \u2014 Isolated Rehearsal",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "V2 committed",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "yeodam_request_cutover_phase_v2",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "V1 requests in flight",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "yeodam_request_cutover_inflight_v1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Held requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "yeodam_request_cutover_waiters",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Hold wait p95 / seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(yeodam_request_cutover_wait_seconds_bucket[1m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Request p99 / seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(yeodam_request_cutover_duration_seconds_bucket[1m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Abort count",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "yeodam_request_cutover_aborts_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Forwarded by target",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "yeodam_request_cutover_forwarded_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Completion / cancellation / unknown",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "yeodam_request_cutover_outcomes_total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Read-only exporter up",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "yeodam_request_cutover_exporter_up",
          "refId": "A"
        }
      ]
    }
  ]
}
