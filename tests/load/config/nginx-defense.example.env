# Preparation example only. This is not a selected Nginx policy or capacity result.
K6_BASE_URL=https://v1-staging.yeodam-2gether.com
K6_DEFENSE_CONFIRM_TARGET=https://v1-staging.yeodam-2gether.com
K6_DEFENSE_EXECUTE=0
K6_DEFENSE_RUN_ID=replace-before-run
K6_DEFENSE_RPS=1
K6_DEFENSE_DURATION_SECONDS=10
K6_DEFENSE_PREALLOCATED_VUS=10
K6_DEFENSE_MAX_VUS=10
K6_DEFENSE_NO_CONNECTION_REUSE=false
K6_DEFENSE_EXPECTED_PROTOCOL=HTTP/1.1
