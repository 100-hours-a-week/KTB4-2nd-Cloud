# 실제 값은 Shell 환경변수 또는 Git에서 제외된 config/baseline.env로 관리합니다.
K6_BASE_URL=https://yeodam-2gether.com
K6_ACCESS_TOKEN=replace-with-test-account-access-token
K6_DATA_MANIFEST=/absolute/path/to/manifest.json

K6_TRIP_NAME_PREFIX=부하
K6_TRIP_START_DATE=2026-09-28
K6_TRIP_END_DATE=2026-09-29
K6_REGION_CODES=50110

K6_COMPLETED_TRIP_ID=replace-with-completed-trip-id
K6_VIEW_VUS=1
K6_VIEW_DURATION=5m
K6_VIEW_THINK_TIME_SECONDS=2

K6_CLOUD_RELEASE=replace-with-cloud-commit
K6_FRONTEND_RELEASE=replace-with-frontend-commit
K6_BACKEND_RELEASE=replace-with-backend-commit
K6_AI_RELEASE=replace-with-ai-commit
