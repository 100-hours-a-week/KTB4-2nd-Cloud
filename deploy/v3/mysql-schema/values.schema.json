{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "image",
    "imagePullSecret",
    "workerHostname"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "image": {
      "type": "string",
      "pattern": "^$|^ghcr.io/100-hours-a-week/yeodam-v3-mysql-schema@sha256:[a-f0-9]{64}$"
    },
    "imagePullSecret": {
      "const": "ghcr-pull"
    },
    "workerHostname": {
      "type": "string",
      "pattern": "^$|^ip-10-40-[0-9]{1,3}-[0-9]{1,3}\\.ap-northeast-2\\.compute\\.internal$"
    }
  }
}
