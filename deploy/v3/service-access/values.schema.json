{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "serviceAddresses"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "serviceAddresses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aiApi",
        "tripApi"
      ],
      "properties": {
        "aiApi": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "pattern": "^172\\.20\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
            }
          ]
        },
        "tripApi": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "pattern": "^172\\.20\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "serviceAddresses": {
            "properties": {
              "aiApi": {
                "type": "string",
                "pattern": "^172\\.20\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
              },
              "tripApi": {
                "type": "string",
                "pattern": "^172\\.20\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
              }
            }
          }
        }
      }
    }
  ]
}
