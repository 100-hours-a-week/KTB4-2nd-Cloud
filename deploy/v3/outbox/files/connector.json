{
  "connector.class": "io.debezium.connector.mysql.MySqlConnector",
  "tasks.max": "1",
  "database.hostname": "mysql-primary.mysql.svc.cluster.local",
  "database.port": "3306",
  "database.user": "v3_connect_cdc",
  "database.password": "${env:V3_CDC_PASSWORD}",
  "database.server.id": "54201",
  "topic.prefix": "v3.yeodam.outbox",
  "database.include.list": "yeodam",
  "table.include.list": "yeodam.trip_creation_outbox,yeodam.additional_attachment_upload_outbox,yeodam.story_generation_outbox,yeodam.attachment_conversion_outbox",
  "schema.history.internal.kafka.bootstrap.servers": "yeodam-v3-kafka-kafka-bootstrap.kafka.svc:9093",
  "schema.history.internal.kafka.topic": "prod.yeodam.schema-history",
  "include.schema.changes": "false",
  "tombstones.on.delete": "false",
  "skipped.operations": "u,d,t",
  "snapshot.mode": "initial",
  "snapshot.select.statement.overrides": "yeodam.trip_creation_outbox,yeodam.additional_attachment_upload_outbox,yeodam.story_generation_outbox,yeodam.attachment_conversion_outbox",
  "transforms": "owned,outbox,key",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.table.field.event.id": "outbox_id",
  "transforms.outbox.table.field.event.key": "trip_id",
  "transforms.outbox.table.field.event.payload": "payload",
  "transforms.outbox.table.fields.additional.placement": "event_source:header:outbox-source,request_id:header:X-Request-ID,traceparent:header:traceparent,tracestate:header:tracestate",
  "transforms.outbox.route.by.field": "topic",
  "transforms.outbox.route.topic.replacement": "${routedByValue}",
  "transforms.key.type": "org.apache.kafka.connect.transforms.Cast$Key",
  "transforms.key.spec": "string",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.storage.StringConverter",
  "header.converter": "org.apache.kafka.connect.storage.SimpleHeaderConverter",
  "snapshot.select.statement.overrides.yeodam.trip_creation_outbox": "SELECT * FROM yeodam.trip_creation_outbox WHERE cdc_managed = TRUE AND status = 'PENDING'",
  "snapshot.select.statement.overrides.yeodam.additional_attachment_upload_outbox": "SELECT * FROM yeodam.additional_attachment_upload_outbox WHERE cdc_managed = TRUE AND status = 'PENDING'",
  "snapshot.select.statement.overrides.yeodam.story_generation_outbox": "SELECT * FROM yeodam.story_generation_outbox WHERE cdc_managed = TRUE AND status = 'PENDING'",
  "transforms.owned.type": "io.debezium.transforms.Filter",
  "transforms.owned.language": "jsr223.groovy",
  "transforms.owned.condition": "value != null && (value.op == 'c' || value.op == 'r') && (value.after.cdc_managed == true || value.after.cdc_managed == 1) && value.after.status == 'PENDING' && value.after.getString('event_source').length() >= 0 && value.after.getString('request_id').length() >= 0",
  "errors.tolerance": "none",
  "snapshot.select.statement.overrides.yeodam.attachment_conversion_outbox": "SELECT * FROM yeodam.attachment_conversion_outbox WHERE cdc_managed = TRUE AND status = 'PENDING'",
  "database.ssl.mode": "verify_identity",
  "database.ssl.truststore": "/mnt/mysql-ca/mysql-truststore.jks",
  "database.ssl.truststore.password": "public-ca-only",
  "schema.history.internal.store.only.captured.tables.ddl": "true",
  "schema.history.internal.store.only.captured.databases.ddl": "true",
  "snapshot.locking.mode": "minimal",
  "snapshot.fetch.size": "32",
  "max.batch.size": "32",
  "max.queue.size": "128",
  "max.queue.size.in.bytes": "16777216",
  "poll.interval.ms": "1000",
  "transforms.outbox.table.expand.json.payload": "false",
  "schema.history.internal.producer.security.protocol": "SASL_SSL",
  "schema.history.internal.producer.sasl.mechanism": "SCRAM-SHA-512",
  "schema.history.internal.producer.sasl.jaas.config": "org.apache.kafka.common.security.scram.ScramLoginModule required username=\"v3-connect-outbox\" password=\"${env:V3_KAFKA_PASSWORD}\";",
  "schema.history.internal.producer.ssl.truststore.type": "PEM",
  "schema.history.internal.producer.ssl.truststore.certificates": "${env:V3_KAFKA_CA_PEM}",
  "schema.history.internal.producer.ssl.endpoint.identification.algorithm": "HTTPS",
  "schema.history.internal.consumer.security.protocol": "SASL_SSL",
  "schema.history.internal.consumer.sasl.mechanism": "SCRAM-SHA-512",
  "schema.history.internal.consumer.sasl.jaas.config": "org.apache.kafka.common.security.scram.ScramLoginModule required username=\"v3-connect-outbox\" password=\"${env:V3_KAFKA_PASSWORD}\";",
  "schema.history.internal.consumer.ssl.truststore.type": "PEM",
  "schema.history.internal.consumer.ssl.truststore.certificates": "${env:V3_KAFKA_CA_PEM}",
  "schema.history.internal.consumer.ssl.endpoint.identification.algorithm": "HTTPS",
  "schema.history.internal.producer.acks": "all",
  "schema.history.internal.producer.enable.idempotence": "true",
  "heartbeat.interval.ms": "30000",
  "topic.heartbeat.prefix": "__debezium-heartbeat",
  "predicates": "heartbeat",
  "predicates.heartbeat.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.heartbeat.pattern": "^__debezium-heartbeat\\.v3\\.yeodam\\.outbox$",
  "transforms.owned.predicate": "heartbeat",
  "transforms.owned.negate": "true",
  "transforms.outbox.predicate": "heartbeat",
  "transforms.outbox.negate": "true",
  "transforms.key.predicate": "heartbeat",
  "transforms.key.negate": "true",
  "transforms.outbox.table.fields.additional.error.on.missing": "false",
  "connect.keep.alive.interval.ms": "10000"
}
