logging { level = "warn" }
otelcol.receiver.otlp "apps" {
  http { endpoint = "0.0.0.0:4318" }
  output { traces = [otelcol.processor.memory_limiter.bounded.input] }
}
otelcol.processor.memory_limiter "bounded" {
  check_interval = "1s"
  limit = "96MiB"
  spike_limit = "16MiB"
  output { traces = [otelcol.processor.transform.sanitize.input] }
}
otelcol.processor.transform "sanitize" {
  error_mode = "propagate"
  trace_statements {
    context = "resource"
    statements = ["keep_keys(attributes, [\"service.name\", \"service.namespace\", \"service.version\", \"deployment.environment.name\"])"]
  }
  trace_statements {
    context = "span"
    statements = [
      "delete_key(attributes, \"yeodam.boundary\")",
      "set(attributes[\"yeodam.boundary\"], name) where IsMatch(name, \"^(ai[.](receive|execute|publish)|photo[.]convert|trip[.](process[.]dispatch|result[.]apply))$\")",
      "keep_keys(attributes, [\"http.request.method\", \"http.response.status_code\", \"http.method\", \"http.status_code\", \"http.route\", \"db.system\", \"db.system.name\", \"db.operation.name\", \"error.type\", \"yeodam.operation\", \"yeodam.stage\", \"yeodam.result\", \"yeodam.boundary\"])",
      "delete_key(attributes, \"yeodam.operation\") where attributes[\"yeodam.operation\"] != nil and not IsMatch(attributes[\"yeodam.operation\"], \"^(process|story|parse|search)$\")",
      "delete_key(attributes, \"yeodam.stage\") where attributes[\"yeodam.stage\"] != nil and not IsMatch(attributes[\"yeodam.stage\"], \"^(downloading|embedding|clock|locating|clustering|filtering|finalizing|evaluate|filter|vectors|select|urls|place_notes|perceive|generate|validate|embed|retrieve|sign_url|parse|search|rewrite|selecting[.]filter|selecting[.]vectors|selecting[.]select|selecting[.]urls|writing[.]place_notes|writing[.]perceive|writing[.]generate|verifying[.]validate|finalizing[.]evaluate)$\")",
      "delete_key(attributes, \"yeodam.result\") where attributes[\"yeodam.result\"] != nil and not IsMatch(attributes[\"yeodam.result\"], \"^(success|error|timeout|lease_lost|aborted|too_large|retry|cancelled|duplicate|quarantined|created|registered|rejected)$\")",
      "set(status.message, \"\")",
      "set(name, \"operation\")",
      "set(name, \"HTTP request\") where attributes[\"http.request.method\"] != nil or attributes[\"http.method\"] != nil",
      "set(name, \"database operation\") where attributes[\"db.system\"] != nil or attributes[\"db.system.name\"] != nil",
      "set(name, attributes[\"yeodam.boundary\"]) where attributes[\"yeodam.boundary\"] != nil",
      "set(name, Concat([\"ai.stage.\", attributes[\"yeodam.stage\"]], \"\")) where attributes[\"yeodam.stage\"] != nil",
      "delete_key(attributes, \"yeodam.boundary\")",
    ]
  }
  trace_statements {
    context = "spanevent"
    statements = ["keep_keys(attributes, [\"exception.type\"])", "set(name, \"event\")"]
  }
  output { traces = [otelcol.processor.batch.small.input] }
}
otelcol.processor.batch "small" {
  timeout = "1s"
  send_batch_size = 32
  send_batch_max_size = 64
  output { traces = [otelcol.exporter.otlp.tempo.input] }
}
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "v3-tempo.observability.svc:4317"
    tls { insecure = true }
  }
  sending_queue {
    enabled = true
    num_consumers = 1
    queue_size = 16
  }
  retry_on_failure {
    enabled = true
    initial_interval = "1s"
    max_interval = "5s"
    max_elapsed_time = "30s"
  }
}
