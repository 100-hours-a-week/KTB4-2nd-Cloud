{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {"type": "string", "pattern": "^$|^([1-9][0-9]*m|[0-9]+(\\.[0-9]+)?)$"},
            "memory": {"type": "string", "pattern": "^$|^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"},
            "ephemeral-storage": {"type": "string", "pattern": "^$|^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"}
          },
          "required": ["cpu", "memory", "ephemeral-storage"]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {"type": "string", "pattern": "^$|^([1-9][0-9]*m|[0-9]+(\\.[0-9]+)?)$"},
            "memory": {"type": "string", "pattern": "^$|^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"},
            "ephemeral-storage": {"type": "string", "pattern": "^$|^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"}
          },
          "required": ["cpu", "memory", "ephemeral-storage"]
        }
      },
      "required": ["requests", "limits"]
    },
    "probe": {
      "anyOf": [
        {"type": "object", "maxProperties": 0},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "httpGet": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {"type": "string", "pattern": "^/"},
                "port": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
                "scheme": {"enum": ["HTTP", "HTTPS"]}
              },
              "required": ["path", "port", "scheme"]
            },
            "periodSeconds": {"type": "integer", "minimum": 1},
            "timeoutSeconds": {"type": "integer", "minimum": 1},
            "failureThreshold": {"type": "integer", "minimum": 1},
            "successThreshold": {"const": 1}
          },
          "required": ["httpGet", "periodSeconds", "timeoutSeconds", "failureThreshold", "successThreshold"]
        }
      ]
    },
    "field-resources": {"$ref": "#/$defs/resources"},
    "field-imagePullSecrets": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
      "uniqueItems": true
    },
    "field-environment": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$"},
      "additionalProperties": {"type": "string"}
    },
    "field-configMapRefs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
      "uniqueItems": true
    },
    "field-secretRefs": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
          "key": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
        },
        "required": ["name", "key"]
      }
    },
    "field-probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {"$ref": "#/$defs/probe"},
        "liveness": {"$ref": "#/$defs/probe"},
        "readiness": {"$ref": "#/$defs/probe"}
      },
      "required": ["startup", "liveness", "readiness"]
    },
    "field-terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
    "field-preStopDelaySeconds": {"type": "integer", "minimum": 0},
    "field-rollout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"maxSurge": {"type": "integer", "minimum": 0}, "maxUnavailable": {"type": "integer", "minimum": 0}},
      "required": ["maxSurge", "maxUnavailable"]
    },
    "field-security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsUser": {"type": "integer", "minimum": 0},
        "runAsGroup": {"type": "integer", "minimum": 0},
        "fsGroup": {"type": "integer", "minimum": 0}
      },
      "required": ["runAsUser", "runAsGroup", "fsGroup"]
    },
    "field-scratchSizeLimit": {"type": "string", "pattern": "^$|^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"},
    "field-catalogSizeLimit": {"type": "string", "pattern": "^$|^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"},
    "field-secretVolumes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
          "secretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
          "mountPath": {"type": "string", "pattern": "^/[^\\n]*$"}
        },
        "required": ["name", "secretName", "mountPath"]
      }
    },
    "field-configurationRevision": {"type": "string", "maxLength": 256},
    "field-resources-override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {"type": "string", "pattern": "^$|^([1-9][0-9]*m|[0-9]+(\\.[0-9]+)?)$"},
            "memory": {"type": "string", "pattern": "^$|^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"},
            "ephemeral-storage": {"type": "string", "pattern": "^$|^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"}
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {"type": "string", "pattern": "^$|^([1-9][0-9]*m|[0-9]+(\\.[0-9]+)?)$"},
            "memory": {"type": "string", "pattern": "^$|^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"},
            "ephemeral-storage": {"type": "string", "pattern": "^$|^[1-9][0-9]*(Ki|Mi|Gi|Ti)$"}
          }
        }
      }
    },
    "field-probes-override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "anyOf": [
            {"type": "object", "maxProperties": 0},
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "httpGet": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {"type": "string", "pattern": "^/"},
                    "port": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
                    "scheme": {"enum": ["HTTP", "HTTPS"]}
                  }
                },
                "periodSeconds": {"type": "integer", "minimum": 1},
                "timeoutSeconds": {"type": "integer", "minimum": 1},
                "failureThreshold": {"type": "integer", "minimum": 1},
                "successThreshold": {"const": 1}
              }
            }
          ]
        },
        "liveness": {
          "anyOf": [
            {"type": "object", "maxProperties": 0},
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "httpGet": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {"type": "string", "pattern": "^/"},
                    "port": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
                    "scheme": {"enum": ["HTTP", "HTTPS"]}
                  }
                },
                "periodSeconds": {"type": "integer", "minimum": 1},
                "timeoutSeconds": {"type": "integer", "minimum": 1},
                "failureThreshold": {"type": "integer", "minimum": 1},
                "successThreshold": {"const": 1}
              }
            }
          ]
        },
        "readiness": {
          "anyOf": [
            {"type": "object", "maxProperties": 0},
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "httpGet": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {"type": "string", "pattern": "^/"},
                    "port": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
                    "scheme": {"enum": ["HTTP", "HTTPS"]}
                  }
                },
                "periodSeconds": {"type": "integer", "minimum": 1},
                "timeoutSeconds": {"type": "integer", "minimum": 1},
                "failureThreshold": {"type": "integer", "minimum": 1},
                "successThreshold": {"const": 1}
              }
            }
          ]
        }
      }
    },
    "field-security-override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsUser": {"type": "integer", "minimum": 0},
        "runAsGroup": {"type": "integer", "minimum": 0},
        "fsGroup": {"type": "integer", "minimum": 0}
      }
    },
    "field-rollout-override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"maxSurge": {"type": "integer", "minimum": 0}, "maxUnavailable": {"type": "integer", "minimum": 0}}
    }
  },
  "type": "object",
  "additionalProperties": false,
