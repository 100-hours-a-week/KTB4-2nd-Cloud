    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {"type": "string", "pattern": "^$|^ghcr\\.io/[a-z0-9][a-z0-9._/-]*@sha256:[a-f0-9]{64}$"},
        "websocket": {"type": "string", "pattern": "^$|^ghcr\\.io/[a-z0-9][a-z0-9._/-]*@sha256:[a-f0-9]{64}$"},
        "frontend": {"type": "string", "pattern": "^$|^ghcr\\.io/[a-z0-9][a-z0-9._/-]*@sha256:[a-f0-9]{64}$"},
        "ai": {"type": "string", "pattern": "^$|^ghcr\\.io/[a-z0-9][a-z0-9._/-]*@sha256:[a-f0-9]{64}$"}
      },
      "required": ["backend", "websocket", "frontend", "ai"]
