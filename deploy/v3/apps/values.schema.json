              "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 65535}
            },
            "service": {
              "type": "object",
              "additionalProperties": false,
              "properties": {"enabled": {"type": "boolean"}, "port": {"type": "integer", "minimum": 0, "maximum": 65535}},
              "required": ["enabled", "port"]
