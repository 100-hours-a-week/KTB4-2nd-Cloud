[mysqld]
datadir=/var/lib/mysql/data
socket=/tmp/mysql.sock
pid-file=/tmp/mysql.pid
tmpdir=/var/lib/mysql/scratch
bind-address=0.0.0.0
port=3306
mysqlx=0
skip-name-resolve=ON
log-error-verbosity=2
general-log=OFF
slow-query-log=OFF
require-secure-transport=ON
ssl-ca=/tls/ca.crt
ssl-cert=/tls/tls.crt
ssl-key=/tls/tls.key
gtid-mode=ON
enforce-gtid-consistency=ON
log-bin=mysql-bin
binlog-format=ROW
binlog-row-image=FULL
log-replica-updates=ON
binlog-expire-logs-seconds=604800
max-binlog-size=64M
sync-binlog=1
innodb-flush-log-at-trx-commit=1
innodb-buffer-pool-size=256M
innodb-redo-log-capacity=100M
max-connections=60
table-open-cache=256
table-definition-cache=400
performance-schema=ON
performance-schema-digests-size=1000
performance-schema-events-statements-history-size=0
performance-schema-events-transactions-history-size=0
read-only=ON
super-read-only=ON
relay-log=relay-bin
relay-log-recovery=ON
plugin-load-add=semisync_source.so
plugin-load-add=semisync_replica.so
rpl-semi-sync-source-enabled=OFF
rpl-semi-sync-replica-enabled=ON
rpl-semi-sync-source-wait-point=AFTER_SYNC
rpl-semi-sync-source-wait-for-replica-count=1
rpl-semi-sync-source-timeout=5000
