{
  "uid": "yeodam-v3-operations",
  "title": "Yeodam V3 operations",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "yeodam",
    "v3"
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {"id": 1,"title": "Pod Ready","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 0,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "kube_pod_status_ready{condition=\"true\"}","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 2,"title": "Container restarts","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 12,"y": 0,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "increase(kube_pod_container_status_restarts_total[5m])","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 3,"title": "Last termination: OOM","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 7,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\"}","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 4,"title": "Node allocatable CPU","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 12,"y": 7,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "kube_node_status_allocatable{resource=\"cpu\"}","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 5,"title": "Container CPU cores","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 14,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "sum by (namespace,pod) (rate(container_cpu_usage_seconds_total[2m]))","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 6,"title": "Container memory bytes","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 12,"y": 14,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "sum by (namespace,pod) (container_memory_working_set_bytes)","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 7,"title": "BE request rate","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 21,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "sum by (workload,status) (rate(http_server_requests_seconds_count{job=\"backend\",uri!~\"/actuator.*\"}[2m]))","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 8,"title": "BE HTTP error ratio","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 12,"y": 21,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "sum by (workload) (rate(http_server_requests_seconds_count{job=\"backend\",status=~\"5..\"}[2m])) / sum by (workload) (rate(http_server_requests_seconds_count{job=\"backend\"}[2m]))","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 9,"title": "BE request p95 seconds","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 28,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "histogram_quantile(0.95,sum by (le,workload) (rate(http_server_requests_seconds_bucket{job=\"backend\",uri!~\"/actuator.*\"}[2m])))","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 10,"title": "AI work queues","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 12,"y": 28,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "yeodam_ai_jobs","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 11,"title": "AI operation p95 seconds","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 35,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "histogram_quantile(0.95,sum by (le,operation,phase) (rate(yeodam_ai_operation_duration_seconds_bucket[5m])))","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 12,"title": "CDC probe success (unknown when 0)","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 12,"y": 35,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "yeodam_cdc_probe_success","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 13,"title": "CDC Connector state","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 42,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "yeodam_cdc_connector_state","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 14,"title": "CDC Task state","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 12,"y": 42,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "yeodam_cdc_task_state","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 15,"title": "CDC expected Task 0 present","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 49,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "yeodam_cdc_expected_task_present","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 16,"title": "Scrape success (missing is not zero work)","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 12,"y": 49,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "up","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 17,"title": "Prometheus resident memory","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 56,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "process_resident_memory_bytes{job=\"prometheus\"}","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}}
  ]
}
