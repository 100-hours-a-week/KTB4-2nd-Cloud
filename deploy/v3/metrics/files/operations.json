    "v3" ,
    {"id": 18, "title": "Connect container restarts and JVM start (Pod UID may stay unchanged)", "description": "Restart count is cumulative. Container start is converted from Prometheus seconds to Grafana date milliseconds. Missing is UNKNOWN. Correlate kubelet/previous-container logs for the cause.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "v3-prometheus"}, "gridPos": {"x": 0, "y": 63, "w": 24, "h": 8}, "targets": [{"refId": "A", "expr": "kube_pod_container_status_restarts_total{namespace=\"kafka\",pod=\"yeodam-v3-connect-connect-0\",container=\"yeodam-v3-connect-connect\"}", "legendFormat": "restart count"}, {"refId": "B", "expr": "1000 * max(container_start_time_seconds{namespace=\"kafka\",pod=\"yeodam-v3-connect-connect-0\",container=\"yeodam-v3-connect-connect\"})", "legendFormat": "container started at"}], "fieldConfig": {"defaults": {"custom": {"spanNulls": false}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "unit", "value": "dateTimeAsIso"}, {"id": "custom.axisPlacement", "value": "right"}]}]}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}}
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {"id": 1,"title": "Pod Ready","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 0,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "kube_pod_status_ready{condition=\"true\"}","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 2,"title": "Container restarts","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 12,"y": 0,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "increase(kube_pod_container_status_restarts_total[5m])","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 3,"title": "Last termination: OOM","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 7,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\"}","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 4,"title": "Node allocatable CPU","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 12,"y": 7,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "kube_node_status_allocatable{resource=\"cpu\"}","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 5,"title": "Container CPU cores","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 14,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "sum by (namespace,pod) (rate(container_cpu_usage_seconds_total[2m]))","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 6,"title": "Container memory bytes","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 12,"y": 14,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "sum by (namespace,pod) (container_memory_working_set_bytes)","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 7,"title": "BE request rate","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 21,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "sum by (workload,status) (rate(http_server_requests_seconds_count{job=\"backend\",uri!~\"/actuator.*\"}[2m]))","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 8,"title": "BE HTTP error ratio","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 12,"y": 21,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "sum by (workload) (rate(http_server_requests_seconds_count{job=\"backend\",status=~\"5..\"}[2m])) / sum by (workload) (rate(http_server_requests_seconds_count{job=\"backend\"}[2m]))","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 9,"title": "BE request p95 seconds","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 28,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "histogram_quantile(0.95,sum by (le,workload) (rate(http_server_requests_seconds_bucket{job=\"backend\",uri!~\"/actuator.*\"}[2m])))","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 10,"title": "AI work queues","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 12,"y": 28,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "yeodam_ai_jobs","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 11,"title": "AI operation p95 seconds","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 35,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "histogram_quantile(0.95,sum by (le,operation,phase) (rate(yeodam_ai_operation_duration_seconds_bucket[5m])))","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 12, "title": "CDC probe success (unknown when 0)", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "v3-prometheus"}, "gridPos": {"x": 12, "y": 35, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "yeodam_cdc_probe_success", "legendFormat": "REST observation"}], "fieldConfig": {"defaults": {"custom": {"spanNulls": false}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}, "description": "0 means UNKNOWN; 1 means the REST status endpoint was readable, not business delivery."},
    {"id": 13, "title": "CDC Connector state", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "v3-prometheus"}, "gridPos": {"x": 0, "y": 42, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "yeodam_cdc_connector_state and on(job, instance) (yeodam_cdc_probe_success == 1) and on(job, instance) (up{job=\"cdc-status\"} == 1)", "legendFormat": "{{connector}} {{task}} {{state}}"}], "fieldConfig": {"defaults": {"custom": {"spanNulls": false}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": []}}, "description": "REST-reported status only; Kafka status storage can retain the last report during a partition. Missing observations are UNKNOWN, not continuous RUNNING or delivery proof."},
    {"id": 14, "title": "CDC Task state", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "v3-prometheus"}, "gridPos": {"x": 12, "y": 42, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "yeodam_cdc_task_state and on(job, instance) (yeodam_cdc_probe_success == 1) and on(job, instance) (up{job=\"cdc-status\"} == 1)", "legendFormat": "{{connector}} {{task}} {{state}}"}], "fieldConfig": {"defaults": {"custom": {"spanNulls": false}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": []}}, "description": "REST-reported status only; Kafka status storage can retain the last report during a partition. Missing observations are UNKNOWN, not continuous RUNNING or delivery proof."},
    {"id": 15, "title": "CDC expected Task 0 present", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "v3-prometheus"}, "gridPos": {"x": 0, "y": 49, "w": 12, "h": 7}, "targets": [{"refId": "A", "expr": "yeodam_cdc_expected_task_present and on(job, instance) (yeodam_cdc_probe_success == 1) and on(job, instance) (up{job=\"cdc-status\"} == 1)", "legendFormat": "{{connector}} {{task}} {{state}}"}], "fieldConfig": {"defaults": {"custom": {"spanNulls": false}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": []}}, "description": "REST-reported status only; Kafka status storage can retain the last report during a partition. Missing observations are UNKNOWN, not continuous RUNNING or delivery proof."},
    {"id": 16,"title": "Scrape success (missing is not zero work)","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 12,"y": 49,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "up","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 17,"title": "Prometheus resident memory","type": "timeseries","datasource": {"type": "prometheus","uid": "v3-prometheus"},"gridPos": {"x": 0,"y": 56,"w": 12,"h": 7},"targets": [{"refId": "A","expr": "process_resident_memory_bytes{job=\"prometheus\"}","legendFormat": "{{workload}} {{namespace}} {{pod}} {{state}} {{phase}}"}],"fieldConfig": {"defaults": {"custom": {"spanNulls": false}},"overrides": []},"options": {"legend": {"displayMode": "table","placement": "bottom"}}},
    {"id": 18, "title": "Connect container restarts and JVM start (Pod UID may stay unchanged)", "description": "Restart count is cumulative. Container start is converted from Prometheus seconds to Grafana date milliseconds. Missing is UNKNOWN. Correlate kubelet/previous-container logs for the cause.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "v3-prometheus"}, "gridPos": {"x": 0, "y": 63, "w": 24, "h": 8}, "targets": [{"refId": "A", "expr": "kube_pod_container_status_restarts_total{namespace=\"kafka\",pod=\"yeodam-v3-connect-connect-0\",container=\"yeodam-v3-connect-connect\"}", "legendFormat": "restart count"}, {"refId": "B", "expr": "1000 * max(container_start_time_seconds{namespace=\"kafka\",pod=\"yeodam-v3-connect-connect-0\",container=\"yeodam-v3-connect-connect\"})", "legendFormat": "container started at"}], "fieldConfig": {"defaults": {"custom": {"spanNulls": false}}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "unit", "value": "dateTimeAsIso"}, {"id": "custom.axisPlacement", "value": "right"}]}]}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 19, "title": "Converter lease policy — seconds, not recovery proof", "description": "Backend image must support lease metrics. Maxima are rolling Micrometer maxima, not an all-time maximum. Correlate with DB lease, container Ready and the preregistered W2K result; no zero filling.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "v3-prometheus"}, "gridPos": {"x": 0, "y": 71, "w": 24, "h": 8}, "targets": [{"refId": "A", "expr": "yeodam_attachment_conversion_lease_duration_seconds{namespace=\"photo\"}", "legendFormat": "lease_seconds {{pod}} {{outcome}}"}, {"refId": "B", "expr": "yeodam_attachment_conversion_lease_renew_interval_seconds{namespace=\"photo\"}", "legendFormat": "renew_interval_seconds {{pod}} {{outcome}}"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"spanNulls": false}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 20, "title": "Converter heartbeat gap / scheduler delay / renew duration — rolling maxima", "description": "Backend image must support lease metrics. Maxima are rolling Micrometer maxima, not an all-time maximum. Correlate with DB lease, container Ready and the preregistered W2K result; no zero filling.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "v3-prometheus"}, "gridPos": {"x": 0, "y": 79, "w": 24, "h": 8}, "targets": [{"refId": "A", "expr": "yeodam_attachment_conversion_lease_heartbeat_gap_seconds_max{namespace=\"photo\"}", "legendFormat": "heartbeat_gap_max {{pod}} {{outcome}}"}, {"refId": "B", "expr": "yeodam_attachment_conversion_lease_heartbeat_delay_seconds_max{namespace=\"photo\"}", "legendFormat": "heartbeat_delay_max {{pod}} {{outcome}}"}, {"refId": "C", "expr": "yeodam_attachment_conversion_lease_heartbeat_renew_seconds_max{namespace=\"photo\"}", "legendFormat": "heartbeat_renew_max {{pod}} {{outcome}}"}, {"refId": "D", "expr": "yeodam_attachment_conversion_lease_renew_gap_seconds_max{namespace=\"photo\"}", "legendFormat": "all renewal gap {{pod}}"}, {"refId": "E", "expr": "yeodam_attachment_conversion_lease_renew_duration_seconds_max{namespace=\"photo\"}", "legendFormat": "all renewal DB duration {{pod}}"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"spanNulls": false}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 21, "title": "Converter heartbeat outcomes — missing is not zero", "description": "Backend image must support lease metrics. Maxima are rolling Micrometer maxima, not an all-time maximum. Correlate with DB lease, container Ready and the preregistered W2K result; no zero filling.", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "v3-prometheus"}, "gridPos": {"x": 0, "y": 87, "w": 24, "h": 8}, "targets": [{"refId": "A", "expr": "yeodam_attachment_conversion_lease_heartbeat_total{namespace=\"photo\"}", "legendFormat": "heartbeat_outcomes {{pod}} {{outcome}}"}], "fieldConfig": {"defaults": {"unit": "short", "custom": {"spanNulls": false}}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}}
  ]
