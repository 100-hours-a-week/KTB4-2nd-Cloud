{
  "uid": "yeodam-v3-apm-integrity",
  "title": "V3 APM collection integrity",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "v3",
    "apm"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "APM observation availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "v3-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"apm-alloy|apm-tempo\"}",
          "legendFormat": "{{job}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Alloy byte queue",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "v3-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_exporter_queue_size{job=\"apm-alloy\",data_type=\"traces\"}",
          "legendFormat": "{{job}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Alloy byte queue capacity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "v3-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_exporter_queue_capacity{job=\"apm-alloy\",data_type=\"traces\"}",
          "legendFormat": "{{job}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Collector rejected spans",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "v3-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(otelcol_exporter_enqueue_failed_spans_total{job=\"apm-alloy\"}[2m]))",
          "legendFormat": "{{job}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Tempo discarded spans by reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "v3-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(tempo_discarded_spans_total{job=\"apm-tempo\"}[2m]))",
          "legendFormat": "{{job}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Spans sent (transport only)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "v3-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_exporter_sent_spans_total{job=\"apm-alloy\"}[2m]))",
          "legendFormat": "{{job}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "APM memory bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "v3-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=~\"apm-alloy|apm-tempo\"}",
          "legendFormat": "{{job}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    }
  ]
}
