# Local validation example. Production runtime values are rendered from Parameter Store.
# Image SHA/Digest values are managed separately in image-versions.env.

# Backend의 AI_SERVER_API_KEY와 같은 값 (AI는 Authorization: Bearer {API_KEY}로 검증)
API_KEY=replace-me

# App의 ATTACHMENT_S3_BUCKET과 같은 버킷 (원본 사진). Worker 인스턴스 역할로 읽음
S3_BUCKET=replace-with-application-bucket-name

FAKE_PIPELINE=0
LOG_LEVEL=INFO
