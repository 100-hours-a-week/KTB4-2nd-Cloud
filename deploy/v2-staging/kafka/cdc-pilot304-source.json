{
  "name": "yeodam-migration-b1-pilot304-source",
  "connector.class": "io.debezium.connector.mysql.MySqlConnector",
  "tasks.max": "1",
  "database.hostname": "10.30.0.174",
  "database.port": "3306",
  "database.user": "yeodam_cdc_test",
  "database.password": "${file:/run/yeodam-cdc/b1-source.properties:password}",
  "database.server.id": "5402",
  "database.ssl.mode": "required",
  "database.include.list": "yeodam_v1_source",
  "table.include.list": "yeodam_v1_source.users,yeodam_v1_source.trips,yeodam_v1_source.trip_regions",
  "topic.prefix": "staging.yeodam.migration.b1.pilot304",
  "snapshot.mode": "initial",
  "snapshot.locking.mode": "minimal",
  "snapshot.select.statement.overrides": "yeodam_v1_source.trips,yeodam_v1_source.trip_regions",
  "snapshot.select.statement.overrides.yeodam_v1_source.trips": "SELECT * FROM yeodam_v1_source.trips WHERE trip_id BETWEEN 1 AND 4",
  "snapshot.select.statement.overrides.yeodam_v1_source.trip_regions": "SELECT * FROM yeodam_v1_source.trip_regions WHERE trip_id BETWEEN 1 AND 4",
  "schema.history.internal.kafka.bootstrap.servers": "kafka.staging.yeodam.internal:9092",
  "schema.history.internal.kafka.topic": "staging.yeodam.migration.b1.pilot304.schema-history",
  "schema.history.internal.store.only.captured.tables.ddl": "true",
  "include.schema.changes": "false",
  "tombstones.on.delete": "false",
  "errors.tolerance": "none",
  "producer.override.compression.type": "lz4",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "true",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "true"
}
