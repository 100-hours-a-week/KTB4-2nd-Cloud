{
  "connector.class": "io.debezium.connector.mysql.MySqlConnector",
  "tasks.max": "1",
  "database.hostname": "mysql-predeploy.production.yeodam.internal",
  "database.port": "3306",
  "database.user": "yeodam_outbox_cdc",
  "database.password": "${file:/run/yeodam-cdc/mysql.properties:password}",
  "database.server.id": "5402",
  "database.ssl.mode": "required",
  "database.include.list": "yeodam",
  "table.include.list": "yeodam.trip_creation_outbox,yeodam.additional_attachment_upload_outbox,yeodam.story_generation_outbox",
  "topic.prefix": "prod.yeodam.outbox",
  "snapshot.mode": "initial",
  "snapshot.locking.mode": "none",
  "schema.history.internal.kafka.bootstrap.servers": "kafka.production.yeodam.internal:9092",
  "schema.history.internal.kafka.topic": "prod.yeodam.schema-history",
  "schema.history.internal.store.only.captured.tables.ddl": "true",
  "include.schema.changes": "false",
  "tombstones.on.delete": "false",
  "errors.tolerance": "none",
  "producer.override.compression.type": "lz4",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.storage.StringConverter",
  "transforms": "managedInsert,outbox",
  "transforms.managedInsert.type": "io.debezium.transforms.Filter",
  "transforms.managedInsert.language": "jsr223.groovy",
  "transforms.managedInsert.condition": "(value.op == 'c' || value.op == 'r') && (value.after.cdc_managed == true || value.after.cdc_managed == 1) && value.after.status == 'PENDING'",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.route.by.field": "topic",
  "transforms.outbox.route.topic.replacement": "${routedByValue}",
  "transforms.outbox.table.field.event.id": "outbox_id",
  "transforms.outbox.table.field.event.key": "trip_id",
  "transforms.outbox.table.field.event.payload": "payload",
  "transforms.outbox.table.expand.json.payload": "false",
  "transforms.outbox.table.fields.additional.placement": "event_source:header:outbox-source,request_id:header:request_id",
  "name": "yeodam-production-outbox",
  "producer.override.acks": "all",
  "producer.override.enable.idempotence": "true",
  "snapshot.select.statement.overrides": "yeodam.trip_creation_outbox,yeodam.additional_attachment_upload_outbox,yeodam.story_generation_outbox",
  "snapshot.select.statement.overrides.yeodam.trip_creation_outbox": "SELECT * FROM yeodam.trip_creation_outbox WHERE cdc_managed = 1 AND status = 'PENDING'",
  "snapshot.select.statement.overrides.yeodam.additional_attachment_upload_outbox": "SELECT * FROM yeodam.additional_attachment_upload_outbox WHERE cdc_managed = 1 AND status = 'PENDING'",
  "snapshot.select.statement.overrides.yeodam.story_generation_outbox": "SELECT * FROM yeodam.story_generation_outbox WHERE cdc_managed = 1 AND status = 'PENDING'"
}
