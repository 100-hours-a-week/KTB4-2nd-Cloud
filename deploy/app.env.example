# Local validation example. Production runtime values are rendered from Parameter Store.
# Image SHA/Digest values are managed separately in image-versions.env.

# Host MySQL
MYSQL_URL=jdbc:mysql://host.docker.internal:3306/yeodam
MYSQL_USERNAME=yeodam_app
MYSQL_PASSWORD=replace-me

# AWS and application data
AWS_REGION=ap-northeast-2
ATTACHMENT_S3_BUCKET=replace-with-application-bucket-name

# AI Worker
AI_SERVER_BASE_URL=http://replace-with-worker-private-ip:8000
AI_SERVER_API_KEY=replace-me
AI_EC2_INSTANCE_ID=i-replace-me

# OAuth and browser access
FRONTEND_OAUTH_CALLBACK_URI=https://yeodam-2gether.com/auth/callback
KAKAO_CLIENT_ID=replace-me
KAKAO_REDIRECT_URI=https://yeodam-2gether.com/api/auth/kakao/callback
KAKAO_CLIENT_SECRET=replace-me
JWT_SECRET=replace-with-at-least-32-bytes
JWT_ISSUER=https://yeodam-2gether.com
FRONTEND_ORIGIN=https://yeodam-2gether.com

# External place API
DATA_GO_KR_SERVICE_KEY=
DATA_GO_KR_LEGAL_DISTRICT_API_URL=https://apis.data.go.kr/1741000/StanReginCd/getStanReginCdList
DATA_GO_KR_TIMEOUT=10s
