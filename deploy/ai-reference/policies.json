{
  "bucket": "yeodam-v1-app-data-483175530259-ap-northeast-2",
  "prefix": "ai-reference/places/",
  "uploader": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AIPlaceReferenceBucketLocation",
        "Effect": "Allow",
        "Action": "s3:GetBucketLocation",
        "Resource": "arn:aws:s3:::yeodam-v1-app-data-483175530259-ap-northeast-2"
      },
      {
        "Sid": "AIPlaceReferenceList",
        "Effect": "Allow",
        "Action": "s3:ListBucket",
        "Resource": "arn:aws:s3:::yeodam-v1-app-data-483175530259-ap-northeast-2",
        "Condition": {"StringLike": {"s3:prefix": "ai-reference/places/*"}}
      },
      {
        "Sid": "AIPlaceReferenceUploadRead",
        "Effect": "Allow",
        "Action": ["s3:PutObject", "s3:GetObject", "s3:GetObjectVersion", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
        "Resource": "arn:aws:s3:::yeodam-v1-app-data-483175530259-ap-northeast-2/ai-reference/places/*"
      }
    ]
  },
  "runner": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "AIPlaceReferenceBucketLocation",
        "Effect": "Allow",
        "Action": "s3:GetBucketLocation",
        "Resource": "arn:aws:s3:::yeodam-v1-app-data-483175530259-ap-northeast-2"
      },
      {
        "Sid": "AIPlaceReferenceList",
        "Effect": "Allow",
        "Action": "s3:ListBucket",
        "Resource": "arn:aws:s3:::yeodam-v1-app-data-483175530259-ap-northeast-2",
        "Condition": {"StringLike": {"s3:prefix": "ai-reference/places/*"}}
      },
      {
        "Sid": "AIPlaceReferenceRead",
        "Effect": "Allow",
        "Action": ["s3:GetObject", "s3:GetObjectVersion"],
        "Resource": "arn:aws:s3:::yeodam-v1-app-data-483175530259-ap-northeast-2/ai-reference/places/*"
      }
    ]
  }
}
